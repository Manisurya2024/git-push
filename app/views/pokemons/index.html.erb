<div class="d-flex justify-content-between align-items-center mb-3 section-title">
  <h2 class="fw-bold">Pokémon Collection</h2>

  <div class="d-flex gap-2 align-items-center">
    <form method="get" class="d-flex align-items-center" action="<%= pokemons_path %>">
      <input type="text" name="q" value="<%= @q %>" class="form-control form-control-sm me-2" placeholder="Search Pokémon">
      <select name="per_page" class="form-select form-select-sm me-2" style="width:95px;">
        <% [8, 12, 20, 40].each do |n| %>
          <option value="<%= n %>" <%= "selected" if n == @per_page.to_i %>><%= n %></option>
        <% end %>
      </select>
      <button class="btn btn-sm btn-outline-dark" type="submit">Apply</button>
    </form>

    <div class="text-muted small">Showing <strong><%= @cards.count %></strong> cards</div>
  </div>
</div>

<div class="row g-3">
  <% @cards.each do |pokemon| %>
    <div class="col-6 col-md-3 mb-3 d-flex">
      <div class="card pokemon-card text-center flex-fill">
        <div>
          <img src="<%= pokemon.image_url %>" alt="<%= pokemon.name %>" class="pokemon-img mx-auto d-block">
        </div>

        <div class="card-body">
          <h6 class="fw-semibold mb-1"><%= pokemon.name %></h6>

          <div class="mb-2">
            <% if pokemon.primary_type.present? %>
              <span class="type-badge <%= pokemon_type_class(pokemon.primary_type) %>"><%= pokemon.primary_type %></span>
            <% end %>
            <% if pokemon.secondary_type.present? %>
              <span class="type-badge <%= pokemon_type_class(pokemon.secondary_type) %>"><%= pokemon.secondary_type %></span>
            <% end %>
          </div>

          <div class="mt-2">
            <%= link_to "View Details", pokemon_path(pokemon), class: "btn btn-primary btn-sm" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-4">
  <h3 class="fw-semibold mb-2">Pokémon Table</h3>

  <div class="table-responsive">
    <table class="table table-striped table-custom">
      <thead>
        <tr>
          <th style="width:70px">#</th>
          <th>Name</th>
          <th style="width:110px">Image</th>
          <th>Types</th>
          <th style="width:90px">Action</th>
        </tr>
      </thead>

      <tbody>
        <% @pokemons.each do |p| %>
          <tr>
            <td class="align-middle"><%= p.pokedex_number || "-" %></td>
            <td class="align-middle"><%= p.name %></td>
            <td class="align-middle">
              <% if p.image_url.present? %>
                <img src="<%= p.image_url %>" alt="<%= p.name %>" style="height:28px;">
              <% end %>
            </td>
            <td class="align-middle">
              <% if p.primary_type.present? %>
                <span class="type-badge <%= pokemon_type_class(p.primary_type) %>"><%= p.primary_type %></span>
              <% end %>
              <% if p.secondary_type.present? %>
                <span class="type-badge <%= pokemon_type_class(p.secondary_type) %>"><%= p.secondary_type %></span>
              <% end %>
            </td>
            <td class="align-middle">
              <%= link_to "View", pokemon_path(p), class: "btn btn-sm btn-outline-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>