<!DOCTYPE html>
<html>
  <head>
    <title>Pokédex Explorer</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pokemon", media: "all", "data-turbo-track": "reload" %>
  </head>

  <body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(90deg, #ffcb05, #ff6b00);">
      <div class="container" style="max-width: 1100px;">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="<%= root_path %>">
          <span style="font-size:22px;">🔴⚪</span>
          <span style="line-height:1;">Pokédex Explorer</span>
        </a>
        <div class="ms-auto d-none d-lg-flex align-items-center">
          <small class="text-white opacity-85">Mini portfolio demo</small>
        </div>
      </div>
    </nav>

    <div class="container py-4" style="max-width: 1100px;">
      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>